pipeline {
    agent any

    // 1 minutes check github remote repo
    triggers {
        pollSCM('* * * * *')
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('2. Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('3. Run Unit Test') {
            steps {
                // Jika unit test gagal, pipeline berhenti di sini dan aplikasi lama tetap aman
                sh 'npm test'
            }
        }

        stage('4. Deploy / Up Aplikasi Lokal') {
            steps {
                echo 'Unit test LOLOS! Menyalakan aplikasi di port 3000...'
                // Matikan proses lama di port 3000 jika ada, lalu jalankan yang baru di background
                sh '''
                    fuser -k 3000/tcp || true
                    JENKINS_NODE_COOKIE=dontKillMe nohup npm run dev > app.log 2>&1 &
                    sleep 2
                '''
            }
        }
    }

    post {
        success {
            echo 'SIMULASI SUKSES! Cek http://localhost:3000 di browser kamu.'
        }
        failure {
            echo 'SIMULASI GAGAL! Unit test error, aplikasi tidak di-deploy.'
        }
    }
}
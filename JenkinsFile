pipeline {
    agent any

    triggers {
        pollSCM('* * * * *')
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('2. Build Image') {
            steps {
                sh 'docker build -t simulasi-app:${BUILD_NUMBER} -t simulasi-app:latest .'
            }
        }

        stage('3. Unit Test') {
            steps {
                sh 'docker run --rm simulasi-app:${BUILD_NUMBER} npm test'
            }
        }

        stage('4. Deploy ke Staging (Port 3001)') {
            steps {
                sh '''
                    docker stop app-staging || true
                    docker rm app-staging || true
                    docker run -d \
                      --name app-staging \
                      --restart unless-stopped \
                      -p 3001:3000 \
                      simulasi-app:${BUILD_NUMBER}
                '''
            }
        }

        
        stage('5. Deploy ke Production (Port 3000)') {
            steps {
                sh '''
                    docker stop app-prod || true
                    docker rm app-prod || true
                    docker run -d \
                      --name app-prod \
                      --restart unless-stopped \
                      -p 3000:3000 \
                      simulasi-app:${BUILD_NUMBER}
                '''
            }
        }
    }

    post {
        success {
            echo "Build #${BUILD_NUMBER} sukses! Staging: http://localhost:3001 | Prod: http://localhost:3000"
        }
        failure {
            echo "Build #${BUILD_NUMBER} GAGAL! Container aktif yang sudah jalan tidak disentuh."
        }
    }
}
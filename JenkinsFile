pipeline {
    agent any

    stages {
        stage('1. Ambil Kode') {
            steps {
                checkout scm
            }
        }

        stage('2. Jalankan Unit Test') {
            steps {
                echo 'Membangun image dan menjalankan unit test Python...'
                // Build image terlebih dahulu agar semua file proyek masuk ke dalam image
                sh 'docker compose build'
                // Jalankan unit test langsung dari dalam image yang baru dirakit (bebas masalah path!)
                sh 'docker compose run --rm app-python python -m unittest'
            }
        }

        stage('3. Deploy Aplikasi') {
            steps {
                echo 'Tes lulus! Menjalankan aplikasi web Python...'
                sh 'docker compose up -d --remove-orphans'
            }
        }

        stage('4. Bersihkan Image Lama') {
            steps {
                sh 'docker image prune -f'
            }
        }
    }
}

pipeline {
    agent any

    triggers {
        pollSCM('* * * * *')
    }

    stages {
        stage('1. Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('2. Build Docker Image') {
            steps {
                sh 'docker build -t simulasi-app:latest .'
            }
        }

        stage('3. Run Unit Test di Container') {
            steps {
                // Jalankan npm test di dalam container sementara (--rm otomatis menghapus container setelah tes selesai)
                sh 'docker run --rm simulasi-app:latest npm test'
            }
        }

        stage('4. Deploy / Up Container Aplikasi') {
            steps {
                echo 'Unit test LOLOS! Menyalakan container aplikasi di port 3000...'
                sh '''
                    docker stop app-prod || true
                    docker rm app-prod || true
                    docker run -d --name app-prod -p 3000:3000 simulasi-app:latest
                '''
            }
        }
    }

    post {
        success {
            echo 'SIMULASI SUKSES! Cek http://localhost:3000 di browser laptopmu.'
        }
        failure {
            echo 'SIMULASI GAGAL! Unit test error, container lama tetap aman berjalan.'
        }
    }
}